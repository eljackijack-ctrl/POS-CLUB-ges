{
  "entities": {
    "Product": {
      "fields": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "categoryName": { "type": "string" },
        "priceFCFA": { "type": "number" },
        "costPriceFCFA": { "type": "number" },
        "format": { "type": "string" },
        "volumeCl": { "type": "number" },
        "currentStock": { "type": "number" },
        "minStockThreshold": { "type": "number" },
        "isAlcoholic": { "type": "boolean" },
        "badge": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "Table": {
      "fields": {
        "id": { "type": "string" },
        "number": { "type": "string" },
        "zone": { "type": "string" },
        "status": { "type": "string" },
        "capacity": { "type": "number" },
        "activeOrderId": { "type": "string" }
      }
    },
    "Order": {
      "fields": {
        "id": { "type": "string" },
        "tableId": { "type": "string" },
        "tableNumber": { "type": "string" },
        "serverName": { "type": "string" },
        "items": { "type": "array" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "totalAmountFCFA": { "type": "number" }
      }
    },
    "Payment": {
      "fields": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "tableId": { "type": "string" },
        "tableNumber": { "type": "string" },
        "serverName": { "type": "string" },
        "cashierName": { "type": "string" },
        "subtotalFCFA": { "type": "number" },
        "discountFCFA": { "type": "number" },
        "finalTotalFCFA": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "items": { "type": "array" },
        "timestamp": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "StockMovement": {
      "fields": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
