        "quantityChange": { "type": "number" },
        "authorName": { "type": "string" },
        "reason": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    },
    "CompanyProfile": {
      "fields": {
        "name": { "type": "string" },
        "subtitle": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "nif": { "type": "string" },
        "rccm": { "type": "string" },
        "currency": { "type": "string" },
        "receiptHeader": { "type": "string" },
        "receiptFooter": { "type": "string" }
      }
    },
    "PrinterConfig": {
      "fields": {
        "paperWidth": { "type": "number" },
        "autoPrintOnPayment": { "type": "boolean" },
        "printDoubleTicket": { "type": "boolean" },
        "printBarVoucher": { "type": "boolean" },
        "showTaxBreakdown": { "type": "boolean" },
        "showQRCode": { "type": "boolean" },
        "fontSize": { "type": "string" }
      }
    }
  },
  "firestore": {
    "products/{productId}": {
      "schema": "Product",
      "description": "Products and beverage stock catalog"
    },
    "tables/{tableId}": {
      "schema": "Table",
      "description": "Club tables and VIP lounges"
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Active and past orders"
    },
    "payments/{paymentId}": {
      "schema": "Payment",
      "description": "Sales payments and transaction receipts"
    },
    "stockMovements/{movementId}": {
      "schema": "StockMovement",
      "description": "Stock movements, refills and adjustments"
    },
    "settings/companyProfile": {
      "schema": "CompanyProfile",
      "description": "Establishment profile and billing settings"
    },
    "settings/printerConfig": {
      "schema": "PrinterConfig",
      "description": "Thermal printer configuration"
    }
  }
}
